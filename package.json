{
  "name": "kulumin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @factory/desktop",
    "desktop": "npm run build:service && npm run tauri --workspace @factory/desktop -- dev",
    "build": "npm run build:service && npm run build --workspace @factory/desktop",
    "build:service": "tsc -p tsconfig.service.json",
    "typecheck": "tsc -p tsconfig.service.json --noEmit && vue-tsc -p apps/desktop/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:codex": "node --import tsx scripts/smoke-codex.ts",
    "test:initialization": "node --import tsx scripts/smoke-initialization.ts",
    "test:implementation": "node --import tsx scripts/smoke-build.ts",
    "service": "node dist/apps/factory-service/src/main.js",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "package:desktop": "npm run icons && npm run build && npm run prepare:desktop && npm run tauri --workspace @factory/desktop -- build --config src-tauri/tauri.release.conf.json --bundles app --ci --no-sign -- --locked --offline && node scripts/finalize-desktop.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "restore": "node --import tsx scripts/restore-backup.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  }
}
