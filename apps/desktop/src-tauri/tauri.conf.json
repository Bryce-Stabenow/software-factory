{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kulumin", "version": "0.1.0", "identifier": "local.kulumin.factory",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Kulumin · Software Factory", "width": 1440, "height": 940, "minWidth": 960, "minHeight": 640 }], "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:" } },
  "bundle": { "active": false, "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/512x512.png", "icons/1024x1024.png"] }
}
